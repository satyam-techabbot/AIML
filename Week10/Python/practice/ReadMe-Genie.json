        "pythonCode": "data = _item[\"json\"][\"body\"]\n\nurl = data.get(\"repo_url\")\n\n# Clean URL\nparts = url.replace(\"https://github.com/\", \"\").strip(\"/\").split(\"/\")\n\nowner = parts[0]\nrepo = parts[1]\n\nreturn {\n    \"owner\": owner,\n    \"repo\": repo\n}"
