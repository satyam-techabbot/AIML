      "id": "3abc896c-1b3c-4330-9803-c654347cb8af",
      "name": "HTTP Request2"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Get current node data (The File Tree from Step 4)\nconst repo = $json;\nconst tree = repo.tree || [];\nconst files = tree.map(f => f.path);\n\n// 2. REACH BACK to Step 3 for Name and Description\n// Note: Replace 'HTTP Request' with the EXACT name of your Step 3 node\nconst repoMetadata = $('HTTP Request').item.json;\n\n// 3. Detect tech stack\nlet tech = [];\n\nif (files.includes(\"package.json\")) tech.push(\"Node.js\");\nif (files.includes(\"requirements.txt\")) tech.push(\"Python\");\nif (files.includes(\"Dockerfile\")) tech.push(\"Docker\");\nif (files.some(f => f.endsWith(\".java\"))) tech.push(\"Java\");\nif (files.some(f => f.endsWith(\".go\"))) tech.push(\"Go\");\n\n// 4. Process structure\nconst structure = files.slice(0, 80).join(\"\\n\");\n\n// 5. Escape newlines for JSON safety\nconst safeStructure = structure.replace(/\\n/g, \"\\\\n\");\n\nreturn {\n    name: repoMetadata.name || \"Unknown Project\",\n    description: repoMetadata.description || \"No description provided\",\n    tech_stack: tech.length > 0 ? tech.join(\", \") : \"Unknown\",\n    structure: safeStructure\n};"
      },
      "type": "n8n-nodes-base.code",
