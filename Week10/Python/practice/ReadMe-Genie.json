        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a senior developer who writes clean professional README.md files.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Generate a README.md with:\\n\\nProject Name: {{$json.name}}\\nDescription: {{ $json.description }}\\nTech Stack: {{$json.tech_stack}}\\n\\nFolder Structure:\\n{{$json.structure}}\\n\\nInclude:\\n- Title\\n- Description\\n- Tech stack\\n- Folder structure\\n- Usage instructions\\n\\nReturn only markdown.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
